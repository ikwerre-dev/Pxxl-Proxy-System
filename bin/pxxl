#!/usr/bin/env sh
set -eu

PROG="${0##*/}"

fail() {
  printf '%s\n' "ERROR: $*" >&2
  exit 1
}

warn() {
  printf '%s\n' "WARN: $*" >&2
}

have() {
  command -v "$1" >/dev/null 2>&1
}

script_dir() {
  src="$0"
  while [ -L "$src" ] && have readlink; do
    dir="$(CDPATH= cd -- "$(dirname "$src")" 2>/dev/null && pwd -P)"
    target="$(readlink "$src")"
    case "$target" in
      /*) src="$target" ;;
      *) src="$dir/$target" ;;
    esac
  done
  CDPATH= cd -- "$(dirname "$src")" 2>/dev/null && pwd -P
}

resolve_app_dir() {
  if [ -n "${PXXL_HOME:-}" ]; then
    [ -f "$PXXL_HOME/docker-compose.yml" ] || fail "PXXL_HOME does not look like a Pxxl checkout: $PXXL_HOME"
    CDPATH= cd -- "$PXXL_HOME" 2>/dev/null && pwd -P
    return
  fi

  dir="$(script_dir)"
  if [ -f "$dir/../docker-compose.yml" ] && [ -f "$dir/../Cargo.toml" ]; then
    CDPATH= cd -- "$dir/.." 2>/dev/null && pwd -P
    return
  fi

  if [ -f "$PWD/docker-compose.yml" ] && [ -f "$PWD/Cargo.toml" ]; then
    pwd -P
    return
  fi

  if [ -n "${HOME:-}" ] && [ -f "$HOME/pxxl-proxy-system/docker-compose.yml" ]; then
    CDPATH= cd -- "$HOME/pxxl-proxy-system" 2>/dev/null && pwd -P
    return
  fi

  fail "could not find Pxxl checkout. Set PXXL_HOME=/path/to/Pxxl-Proxy-System."
}

use_discovery_compose() {
  [ "${PXXL_DISCOVERY:-0}" = "1" ] || [ "${PXXL_RUNTIME_DISCOVERY:-0}" = "1" ]
}

compose() {
  cd "$APP_DIR"
  if docker compose version >/dev/null 2>&1; then
    if use_discovery_compose && [ -f docker-compose.discovery.yml ]; then
      docker compose -f docker-compose.yml -f docker-compose.discovery.yml "$@"
    else
      docker compose "$@"
    fi
  elif have docker-compose; then
    if use_discovery_compose && [ -f docker-compose.discovery.yml ]; then
      docker-compose -f docker-compose.yml -f docker-compose.discovery.yml "$@"
    else
      docker-compose "$@"
    fi
  else
    fail "Docker Compose is required. Install Docker Desktop or the docker compose plugin."
  fi
}

print_help() {
  cat <<EOF
Pxxl Proxy command line

Usage:
  $PROG <command> [args]

Commands:
  status              Show Compose service status
  start [service]     Start the stack or one service
  stop [service]      Stop the stack or one service
  restart [service]   Restart the stack or one service
  reload              Restart only the edge proxy service
  rebuild [service]   Rebuild and start the stack or one service
  down                Stop and remove containers, keeping data/ state
  logs [service]      Follow logs, defaulting to the edge service
  health              Check healthz, readyz, and metrics reachability
  login               Log in with the initial account and print a fresh token once
  account             Show initial account status
  account setup       Set or replace the initial admin email/password
  token refresh       Rotate the one-time bootstrap token in .env
  hosts add <domain> [ip]
                      Add/update a local /etc/hosts entry, default ip 127.0.0.1
  hosts remove <domain>
                      Remove a local /etc/hosts entry
  urls                Print local service URLs
  env                 Show .env keys with values masked
  doctor              Check local requirements and install layout
  update              Run update.sh from the installed checkout
  version             Show checkout version information
  compose <args>      Pass raw arguments to docker compose
  help                Show this help

Environment:
  PXXL_HOME=/path/to/Pxxl-Proxy-System   Use a specific checkout
  PXXL_DISCOVERY=1                       Include docker-compose.discovery.yml
  PXXL_ADMIN_URL=http://127.0.0.1:8081   Override admin health URL
  PXXL_METRICS_URL=http://127.0.0.1:9090/metrics

Examples:
  $PROG status
  $PROG logs edge
  $PROG login
  $PROG token refresh
  $PROG restart
  PXXL_DISCOVERY=1 $PROG rebuild
EOF
}

print_urls() {
  cat <<EOF
Pxxl Proxy URLs

Proxy HTTP:     http://127.0.0.1
Proxy HTTPS:    https://127.0.0.1
Admin API:      ${PXXL_ADMIN_URL:-http://127.0.0.1:8081}
Metrics:        ${PXXL_METRICS_URL:-http://127.0.0.1:9090/metrics}
Prometheus:     http://127.0.0.1:9091
Grafana:        http://127.0.0.1:${GRAFANA_PORT:-3000}

Checkout:
  $APP_DIR
EOF
}

check_url() {
  label="$1"
  url="$2"
  protected_ok="${3:-0}"
  status="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$url" 2>/dev/null || true)"
  [ -n "$status" ] || status="000"
  case "$status" in
    2*|3*)
      printf '%-10s ok      %s (%s)\n' "$label" "$url" "$status"
      return 0
      ;;
    401|403)
      if [ "$protected_ok" = "1" ]; then
        printf '%-10s protected %s (%s)\n' "$label" "$url" "$status"
        return 0
      fi
      ;;
  esac
  printf '%-10s failed  %s (%s)\n' "$label" "$url" "$status"
  return 1
}

health() {
  have curl || fail "curl is required for health checks"
  admin_url="${PXXL_ADMIN_URL:-http://127.0.0.1:8081}"
  metrics_url="${PXXL_METRICS_URL:-http://127.0.0.1:9090/metrics}"
  failed=0
  check_url healthz "$admin_url/healthz" || failed=1
  check_url readyz "$admin_url/readyz" || failed=1
  check_url metrics "$metrics_url" 1 || failed=1
  return "$failed"
}

env_file() {
  printf '%s/.env' "$APP_DIR"
}

env_get_var() {
  key="$1"
  file="$(env_file)"
  [ -f "$file" ] || return 0
  grep "^$key=" "$file" | tail -n 1 | sed "s/^$key=//"
}

env_has_var() {
  key="$1"
  file="$(env_file)"
  [ -f "$file" ] && grep -q "^$key=" "$file"
}

set_env_var() {
  key="$1"
  value="$2"
  file="$(env_file)"
  tmp="$file.tmp.$$"
  [ -f "$file" ] || : > "$file"
  awk -v key="$key" -v value="$value" '
    BEGIN { found = 0 }
    index($0, key "=") == 1 { print key "=" value; found = 1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
  chmod 600 "$file" || true
}

random_hex() {
  have openssl || fail "openssl is required"
  openssl rand -hex "$1"
}

prompt_tty() {
  prompt="$1"
  default="${2:-}"
  [ -r /dev/tty ] || fail "interactive prompt needs a terminal"
  if [ -n "$default" ]; then
    printf '%s [%s]: ' "$prompt" "$default" > /dev/tty
  else
    printf '%s: ' "$prompt" > /dev/tty
  fi
  IFS= read -r value < /dev/tty
  [ -n "$value" ] || value="$default"
  printf '%s' "$value"
}

prompt_secret_tty() {
  prompt="$1"
  [ -r /dev/tty ] || fail "interactive prompt needs a terminal"
  printf '%s: ' "$prompt" > /dev/tty
  old_stty="$(stty -g < /dev/tty 2>/dev/null || true)"
  stty -echo < /dev/tty 2>/dev/null || true
  IFS= read -r value < /dev/tty
  [ -n "$old_stty" ] && stty "$old_stty" < /dev/tty 2>/dev/null || true
  printf '\n' > /dev/tty
  printf '%s' "$value"
}

validate_admin_email() {
  case "$1" in
    *@*.*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    *[[:space:]]*|*@|@*|"") return 1 ;;
  esac
  return 0
}

validate_hosts_domain() {
  case "$1" in
    ""|*[!A-Za-z0-9.-]*|.*|*..*|*.) return 1 ;;
  esac
  return 0
}

hosts_file() {
  printf '/etc/hosts'
}

write_hosts_file() {
  src="$1"
  dst="$(hosts_file)"
  if [ -w "$dst" ]; then
    cp "$src" "$dst"
  else
    have sudo || fail "sudo is required to update $dst"
    sudo cp "$src" "$dst"
  fi
}

hosts_remove_entry() {
  domain="$1"
  validate_hosts_domain "$domain" || fail "invalid hosts domain: $domain"
  file="$(hosts_file)"
  tmp="$(mktemp "${TMPDIR:-/tmp}/pxxl-hosts.XXXXXX")"
  awk -v host="$domain" '
    /^[[:space:]]*#/ { print; next }
    {
      keep = 1
      for (i = 2; i <= NF; i++) {
        if ($i == host) keep = 0
      }
      if (keep) print
    }
  ' "$file" > "$tmp"
  write_hosts_file "$tmp"
  rm -f "$tmp"
  printf 'Removed %s from %s\n' "$domain" "$file"
}

hosts_add_entry() {
  domain="$1"
  ip="${2:-127.0.0.1}"
  validate_hosts_domain "$domain" || fail "invalid hosts domain: $domain"
  case "$ip" in
    *[!0-9a-fA-F:.:]*|"") fail "invalid hosts IP: $ip" ;;
  esac
  file="$(hosts_file)"
  tmp="$(mktemp "${TMPDIR:-/tmp}/pxxl-hosts.XXXXXX")"
  awk -v host="$domain" '
    /^[[:space:]]*#/ { print; next }
    {
      keep = 1
      for (i = 2; i <= NF; i++) {
        if ($i == host) keep = 0
      }
      if (keep) print
    }
  ' "$file" > "$tmp"
  printf '%s\t%s\t# pxxl-local\n' "$ip" "$domain" >> "$tmp"
  write_hosts_file "$tmp"
  rm -f "$tmp"
  printf 'Added %s -> %s in %s\n' "$domain" "$ip" "$file"
}

hash_admin_password() {
  password="$1"
  salt="$(random_hex 16)"
  iterations="${PXXL_ADMIN_PASSWORD_ITERATIONS:-200000}"
  derived="$(openssl kdf -keylen 32 \
    -kdfopt digest:SHA256 \
    -kdfopt "pass:$password" \
    -kdfopt "salt:$salt" \
    -kdfopt "iter:$iterations" \
    PBKDF2 | tr -d ':' | tr 'A-F' 'a-f')"
  printf 'pbkdf2-sha256:%s:%s:%s' "$iterations" "$salt" "$derived"
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

account_status() {
  email="$(env_get_var PXXL_ADMIN_EMAIL)"
  if [ -n "$email" ] && env_has_var PXXL_ADMIN_PASSWORD_HASH; then
    printf 'Initial admin account: configured\n'
    printf 'Email: %s\n' "$email"
    printf 'Password hash: stored in .env\n'
  else
    printf 'Initial admin account: not configured\n'
    printf 'Run: %s account setup\n' "$PROG"
  fi
  if env_has_var PXXL_ADMIN_BOOTSTRAP_TOKEN; then
    printf 'Bootstrap token: set, hidden\n'
  else
    printf 'Bootstrap token: missing; run %s token refresh\n' "$PROG"
  fi
}

account_setup() {
  cd "$APP_DIR"
  [ -f .env ] || : > .env
  current_email="$(env_get_var PXXL_ADMIN_EMAIL)"
  email="${PXXL_ADMIN_EMAIL:-}"
  [ -n "$email" ] || email="$(prompt_tty "Admin email" "$current_email")"
  validate_admin_email "$email" || fail "admin email does not look valid: $email"

  password="${PXXL_ADMIN_PASSWORD:-}"
  if [ -z "$password" ]; then
    password="$(prompt_secret_tty "Admin password")"
    confirm="$(prompt_secret_tty "Confirm admin password")"
    [ "$password" = "$confirm" ] || fail "admin passwords did not match"
  fi
  [ "${#password}" -ge 12 ] || fail "admin password must be at least 12 characters"

  set_env_var PXXL_ADMIN_EMAIL "$email"
  set_env_var PXXL_ADMIN_PASSWORD_HASH "$(hash_admin_password "$password")"
  printf 'Initial admin account saved for %s\n' "$email"
  restart_edge_if_possible
}

login_account() {
  have curl || fail "curl is required"
  email="${PXXL_ADMIN_EMAIL:-}"
  [ -n "$email" ] || email="$(env_get_var PXXL_ADMIN_EMAIL)"
  [ -n "$email" ] || email="$(prompt_tty "Admin email" "")"
  password="${PXXL_ADMIN_PASSWORD:-}"
  [ -n "$password" ] || password="$(prompt_secret_tty "Admin password")"

  admin_url="${PXXL_ADMIN_URL:-http://127.0.0.1:8081}"
  email_json="$(json_escape "$email")"
  password_json="$(json_escape "$password")"
  response="$(curl -sS -X POST "$admin_url/v1/auth/login" \
    -H "content-type: application/json" \
    --data "{\"email\":\"$email_json\",\"password\":\"$password_json\"}" 2>/dev/null || true)"
  token="$(printf '%s' "$response" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')"
  if [ -z "$token" ]; then
    printf '%s\n' "$response" >&2
    fail "login failed"
  fi

  cat <<EOF
Admin token (shown once):
$token

Use it as:
Authorization: Bearer $token

Logging in again rotates this account token and revokes the previous one.
EOF
}

restart_edge_if_possible() {
  if have docker && docker info >/dev/null 2>&1; then
    compose up -d --force-recreate edge >/dev/null
    printf 'Recreated edge service so it can read the updated .env\n'
  else
    warn "Docker daemon is not reachable; run '$PROG reload' after Docker is running"
  fi
}

refresh_bootstrap_token() {
  cd "$APP_DIR"
  [ -f .env ] || : > .env
  token="$(random_hex 32)"
  set_env_var PXXL_ADMIN_BOOTSTRAP_TOKEN "$token"
  restart_edge_if_possible
  cat <<EOF
New bootstrap token (shown once):
$token

The old bootstrap token was removed from .env. The running edge service must be recreated for this token to take effect.
EOF
}

doctor_check() {
  label="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf '%-18s ok\n' "$label"
  else
    printf '%-18s failed\n' "$label"
    DOCTOR_FAILED=1
  fi
}

doctor() {
  DOCTOR_FAILED=0
  printf 'Pxxl checkout: %s\n\n' "$APP_DIR"
  doctor_check "git" have git
  doctor_check "docker" have docker
  doctor_check "compose" compose version
  if have docker; then
    doctor_check "docker daemon" docker info
  else
    printf '%-18s skipped\n' "docker daemon"
    DOCTOR_FAILED=1
  fi
  [ -f "$APP_DIR/.env" ] && printf '%-18s ok\n' ".env" || { printf '%-18s missing\n' ".env"; DOCTOR_FAILED=1; }
  [ -d "$APP_DIR/data" ] && printf '%-18s ok\n' "data/" || { printf '%-18s missing\n' "data/"; DOCTOR_FAILED=1; }
  doctor_check "compose config" compose config
  return "$DOCTOR_FAILED"
}

show_env() {
  cd "$APP_DIR"
  [ -f .env ] || fail ".env does not exist yet. Run ./install.sh first."
  sed 's/=.*/=<set>/' .env
}

version() {
  printf 'Pxxl Proxy CLI\n'
  printf 'Checkout: %s\n' "$APP_DIR"
  if have git && [ -d "$APP_DIR/.git" ]; then
    printf 'Branch:   %s\n' "$(git -C "$APP_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || printf unknown)"
    printf 'Commit:   %s\n' "$(git -C "$APP_DIR" rev-parse --short HEAD 2>/dev/null || printf unknown)"
  fi
}

if [ "$#" -eq 0 ]; then
  print_help
  exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
  help|-h|--help)
    print_help
    exit 0
    ;;
esac

APP_DIR="$(resolve_app_dir)"

case "$COMMAND" in
  status|ps)
    compose ps "$@"
    ;;
  start|up)
    compose up -d "$@"
    compose ps
    ;;
  stop)
    compose stop "$@"
    compose ps
    ;;
  restart)
    compose restart "$@"
    compose ps
    ;;
  reload)
    compose restart edge
    compose ps edge
    ;;
  rebuild|build)
    compose up -d --build --remove-orphans "$@"
    compose ps
    ;;
  down)
    compose down "$@"
    ;;
  logs)
    if [ "$#" -eq 0 ]; then
      compose logs -f --tail=200 edge
    else
      compose logs -f --tail=200 "$@"
    fi
    ;;
  health)
    health
    ;;
  login)
    login_account
    ;;
  account)
    subcommand="${1:-status}"
    case "$subcommand" in
      status) account_status ;;
      setup) account_setup ;;
      *) fail "usage: $PROG account [status|setup]" ;;
    esac
    ;;
  token)
    subcommand="${1:-}"
    case "$subcommand" in
      refresh|rotate) refresh_bootstrap_token ;;
      *) fail "usage: $PROG token refresh" ;;
    esac
    ;;
  hosts)
    subcommand="${1:-}"
    case "$subcommand" in
      add)
        [ "$#" -ge 2 ] || fail "usage: $PROG hosts add <domain> [ip]"
        hosts_add_entry "$2" "${3:-127.0.0.1}"
        ;;
      remove|rm)
        [ "$#" -ge 2 ] || fail "usage: $PROG hosts remove <domain>"
        hosts_remove_entry "$2"
        ;;
      *) fail "usage: $PROG hosts [add|remove] <domain> [ip]" ;;
    esac
    ;;
  urls)
    print_urls
    ;;
  env)
    show_env
    ;;
  doctor)
    doctor
    ;;
  update)
    cd "$APP_DIR"
    sh "$APP_DIR/update.sh" "$@"
    ;;
  version)
    version
    ;;
  compose)
    [ "$#" -gt 0 ] || fail "usage: $PROG compose <docker-compose-args>"
    compose "$@"
    ;;
  *)
    warn "unknown command: $COMMAND"
    printf '\n'
    print_help
    exit 2
    ;;
esac
