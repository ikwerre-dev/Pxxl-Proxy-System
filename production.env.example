# Production control-plane routes. Copy these non-secret values into the
# proxy host's private .env and provide admin tokens through Vault.
PXXL_GATEWAY_UPSTREAM=http://100.90.145.103:8281
PXXL_APP_UPSTREAM=http://100.90.145.103:3201
PXXL_WEB_UPSTREAM=http://100.90.145.103:3200

PXXL_GATEWAY_PROXY_DOMAINS=server.pxxl.app
PXXL_GATEWAY_ALIAS_ENABLED=false
PXXL_GATEWAY_ALIAS_DOMAINS=gateway.pxxl.app
PXXL_APP_PROXY_DOMAINS=app.pxxl.app
PXXL_WEB_PROXY_DOMAINS="pxxl.app www.pxxl.app"

PXXL_GATEWAY_API_URL=https://server.pxxl.app/api/v3
PXXL_DATABASE_PROXY_BASE_HOST=pxxldb.pxxl.pro
