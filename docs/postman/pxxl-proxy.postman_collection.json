{
  "info": {
    "_postman_id": "6ebc9d7e-1b02-4ffd-a773-f5b48b384ef1",
    "name": "Pxxl Proxy API",
    "description": "Local admin API collection for Pxxl Proxy. Import `pxxl-proxy.postman_environment.json` and run Docker Compose before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Healthz",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/healthz"
          }
        },
        {
          "name": "Readyz",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/readyz"
          }
        }
      ]
    },
    {
      "name": "Domains",
      "item": [
        {
          "name": "Create or Update Domain",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domain\": \"{{domain}}\",\n  \"path\": \"/\",\n  \"tls\": true,\n  \"algorithm\": \"round_robin\",\n  \"upstreams\": [\n    {\n      \"url\": \"{{upstreamUrl}}\",\n      \"weight\": 1\n    }\n  ],\n  \"rules\": {\n    \"allow_websocket\": true,\n    \"blocked_methods\": [\"TRACE\"],\n    \"blocked_headers\": [\"x-debug-token\"],\n    \"ip_blocklist\": [\"198.51.100.10\"],\n    \"rate_limit\": {\n      \"enabled\": true,\n      \"requests_per_minute\": 120,\n      \"burst\": 30,\n      \"scope\": \"per_ip\",\n      \"status_code\": 429,\n      \"retry_after_seconds\": 5\n    },\n    \"add_security_headers\": true\n  }\n}"
            },
            "url": "{{baseUrl}}/v1/domains"
          }
        },
        {
          "name": "Create Domain With Strict Rules",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domain\": \"secure.pxxlhost\",\n  \"path\": \"/\",\n  \"tls\": true,\n  \"algorithm\": \"round_robin\",\n  \"upstreams\": [\n    {\n      \"url\": \"{{upstreamUrl}}\",\n      \"weight\": 1\n    }\n  ],\n  \"rules\": {\n    \"allow_websocket\": false,\n    \"require_https\": true,\n    \"redirect_http_to_https\": true,\n    \"allowed_methods\": [\"GET\", \"POST\", \"OPTIONS\"],\n    \"blocked_methods\": [\"TRACE\"],\n    \"allowed_headers\": [\"host\", \"content-type\", \"authorization\", \"origin\", \"user-agent\", \"accept\"],\n    \"blocked_headers\": [\"x-debug-token\", \"x-internal-only\"],\n    \"required_headers\": [\n      { \"name\": \"x-api-version\", \"value\": \"2026-05\" }\n    ],\n    \"strip_request_headers\": [\"x-powered-by\"],\n    \"add_request_headers\": {\n      \"x-forwarded-by\": \"pxxl\"\n    },\n    \"response_headers\": {\n      \"x-proxy\": \"pxxl\"\n    },\n    \"ip_allowlist\": [\"127.0.0.1\", \"203.0.113.0/24\"],\n    \"ip_blocklist\": [\"198.51.100.10\"],\n    \"rate_limit\": {\n      \"enabled\": true,\n      \"requests_per_second\": 10,\n      \"burst\": 20,\n      \"scope\": \"per_ip_path\",\n      \"status_code\": 429,\n      \"retry_after_seconds\": 5\n    },\n    \"max_body_bytes\": 1048576,\n    \"max_uri_length\": 2048,\n    \"allowed_content_types\": [\"application/json\"],\n    \"maintenance_mode\": false,\n    \"preserve_host_header\": false,\n    \"add_security_headers\": true,\n    \"cors_allowed_origins\": [\"https://app.example.com\"],\n    \"cors_allow_credentials\": true,\n    \"cors_allowed_methods\": [\"GET\", \"POST\", \"OPTIONS\"],\n    \"cors_allowed_headers\": [\"content-type\", \"authorization\"],\n    \"cors_preflight_enabled\": true\n  }\n}"
            },
            "url": "{{baseUrl}}/v1/domains"
          }
        },
        {
          "name": "Create Domain With Multiple Paths",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domain\": \"api.pxxlhost\",\n  \"tls\": true,\n  \"paths\": [\n    {\n      \"prefix\": \"/v1\",\n      \"upstreams\": [\n        { \"url\": \"http://host.docker.internal:3001\", \"weight\": 1 }\n      ]\n    },\n    {\n      \"prefix\": \"/v2\",\n      \"upstreams\": [\n        { \"url\": \"http://host.docker.internal:3002\", \"weight\": 1 }\n      ]\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/v1/domains"
          }
        },
        {
          "name": "List Domains",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/domains"
          }
        },
        {
          "name": "Get Domain",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/domains/{{domain}}"
          }
        },
        {
          "name": "Delete Domain",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/domains/{{domain}}"
          }
        }
      ]
    },
    {
      "name": "Stats",
      "item": [
        {
          "name": "All Domain Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/stats/domains"
          }
        },
        {
          "name": "Domain Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/domains/{{domain}}/stats"
          }
        },
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "url": "{{metricsUrl}}/metrics"
          }
        }
      ]
    },
    {
      "name": "Routes and Upstreams",
      "item": [
        {
          "name": "List Routes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/routes"
          }
        },
        {
          "name": "List Upstreams",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/upstreams"
          }
        },
        {
          "name": "Certificate Metadata",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/certs"
          }
        }
      ]
    },
    {
      "name": "Blacklist",
      "item": [
        {
          "name": "Add IP To Domain Blacklist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ip\": \"{{blacklistIp}}\"\n}"
            },
            "url": "{{baseUrl}}/v1/blacklist/{{domain}}"
          }
        },
        {
          "name": "Remove IP From Domain Blacklist",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/blacklist/{{domain}}/{{blacklistIp}}"
          }
        }
      ]
    }
  ]
}
